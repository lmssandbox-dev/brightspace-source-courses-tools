# Read ENVIRONMENT.md before configuring. Placeholder values are not usable credentials.
# One installation per tenant. Keep real .env files and private keys out of source control.

# Infrastructure: choose database path; generate LTI_KEY once (openssl rand -hex 32).
MONGODB_URL=mongodb+srv://REPLACE_USER:REPLACE_URL_ENCODED_PASSWORD@REPLACE_CLUSTER/brightspace_prospect_demo?retryWrites=true&w=majority
LTI_KEY=REPLACE_WITH_GENERATED_RANDOM_SECRET
# Local default; Render normally supplies PORT itself.
PORT=3000

# Copy from the tenant's LTI Advantage registration/deployment.
BS_URL=https://YOUR-TENANT.brightspace.com
BS_NAME="Prospect Brightspace"
BS_CLIENT_ID=REPLACE_WITH_LTI_REGISTRATION_CLIENT_ID
BS_DEPLOYMENT_ID=REPLACE_WITH_LTI_DEPLOYMENT_ID
BS_AUTH_ENDPOINT=https://REPLACE_WITH_PLATFORM_OIDC_AUTHENTICATION_ENDPOINT
BS_TOKEN_ENDPOINT=https://REPLACE_WITH_PLATFORM_ACCESS_TOKEN_ENDPOINT
BS_KEYSET_URL=https://REPLACE_WITH_BRIGHTSPACE_KEYSET_URL

# Separate OAuth 2.0 Client Credentials application linked to a Service User.
D2L_OAUTH2_CLIENT_ID=REPLACE_WITH_OAUTH_APPLICATION_CLIENT_ID
# Choose a key label; the app publishes this as the public JWKS kid.
D2L_OAUTH2_KEY_ID=prospect-api-2026-01
# Generate RSA >=2048 bits. Include the complete PEM; literal \n is supported.
D2L_OAUTH2_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_GENERATED_RSA_PRIVATE_KEY_BODY\n-----END PRIVATE KEY-----"
D2L_OAUTH2_TOKEN_ENDPOINT=https://auth.brightspace.com/core/connect/token
# Space-separated approved read/write/log scopes; see ENVIRONMENT.md.
D2L_OAUTH2_SCOPES="REPLACE_WITH_APPROVED_SPACE_SEPARATED_SCOPES"

# Confirm these versions are supported by your tenant. LE 1.91+ supports copy checks.
D2L_LE_VERSION=1.91
D2L_LP_VERSION=1.53

# Optional shared org-code directory refresh (see RESOLUTION.md).
# Uses existing OAuth credentials and datasets:bds:read; Service User needs dataset access.
ORG_UNIT_DATASET_SYNC_ENABLED=true
# 06:00 UTC = 03:00 Brasília. Run after your tenant's dataset generation window.
ORG_UNIT_DATASET_SYNC_HOUR_UTC=6
# Leave unset for automatic Organizational Units schema discovery.
# ORG_UNIT_DATASET_SCHEMA_ID=REPLACE_WITH_SCHEMA_ID_ONLY_IF_NEEDED
